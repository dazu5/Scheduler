{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Scheduler",
  "version": "0.0.1",
  "identifier": "com.dazu5.scheduler",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Scheduler",
        "width": 1200,
        "height": 800,
        "resizable": true
      },
      {
        "label": "pill",
        "title": "Scheduler Pill",
        "url": "pill.html",
        "width": 260,
        "height": 60,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "transparent": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
